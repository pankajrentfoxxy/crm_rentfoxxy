model Lead {
  leadId                                    Int                              @id @default(autoincrement()) @map("lead_id")
  name                                      String                           @db.VarChar(255)
  companyName                               String?                          @map("company_name") @db.VarChar(255)
  email                                     String?                          @db.VarChar(255)
  phone                                     String?                          @db.VarChar(50)
  city                                      String?                          @db.VarChar(100)
  source                                    String?                          @db.VarChar(100)
  status                                    String                           @default("Pending") @db.VarChar(50)
  assignedUserId                            Int?                             @map("assigned_user_id")
  assignedById                              Int?                             @map("assigned_by")
  assignedAt                                DateTime?                        @map("assigned_at") @db.Timestamptz(6)
  followUpDate                              DateTime?                        @map("follow_up_date") @db.Timestamptz(6)
  isDuplicate                               Boolean?                         @default(false) @map("is_duplicate")
  duplicateOf                               Int?                             @map("duplicate_of")
  rejectionReason                           String?                          @map("rejection_reason")
  researchStatus                            String?                          @default("pending") @map("research_status") @db.VarChar(50)
  researchRequestedAt                       DateTime?                        @map("research_requested_at") @db.Timestamptz(6)
  createdAt                                 DateTime?                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                 DateTime?                        @default(now()) @map("updated_at") @db.Timestamptz(6)
  leadStage                                 String?                          @map("lead_stage") @db.VarChar(200)
  quotation_accept_token                    String?                          @db.VarChar(64)
  quotation_accepted_at                     DateTime?                        @db.Timestamptz(6)
  quotation_last_sent_at                    DateTime?                        @db.Timestamptz(6)
  quotation_last_estimate_no                String?                          @db.VarChar(50)
  quotation_last_to_email                   String?                          @db.VarChar(255)
  whatsappNumber                            String?                          @map("whatsapp_number") @db.VarChar(32)
  designation                               String?                          @db.VarChar(255)
  quantityRequired                          Int?                             @map("quantity_required")
  monthlyBudget                             Decimal?                         @map("monthly_budget") @db.Decimal(12, 2)
  rentalDuration                            Int?                             @map("rental_duration")
  useCase                                   String?                          @map("use_case") @db.VarChar(100)
  companyType                               String?                          @map("company_type") @db.VarChar(100)
  companySize                               Int?                             @map("company_size")
  industry                                  String?                          @db.VarChar(100)
  annualRevenue                             String?                          @map("annual_revenue") @db.VarChar(100)
  panNumber                                 String?                          @map("pan_number") @db.VarChar(20)
  gstNumber                                 String?                          @map("gst_number") @db.VarChar(20)
  state                                     String?                          @db.VarChar(100)
  pincode                                   String?                          @db.VarChar(10)
  billingAddress                            String?                          @map("billing_address")
  shippingSameAsBilling                     Boolean?                         @default(true) @map("shipping_same_as_billing")
  shippingAddress                           String?                          @map("shipping_address")
  followUpTime                              DateTime?                        @map("follow_up_time") @db.Time(6)
  convertedAt                               DateTime?                        @map("converted_at") @db.Timestamptz(6)
  convertedBy                               Int?                             @map("converted_by")
  customerId                                Int?                             @map("customer_id")
  inquiryType                               String?                          @default("rental") @map("inquiry_type") @db.VarChar(50)
  lastActivityAt                            DateTime?                        @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  companyBrand                              String?                          @map("company_brand") @db.VarChar(255)
  brand                                     String?                          @db.VarChar(100)
  processor                                 String?                          @db.VarChar(100)
  generation                                String?                          @db.VarChar(50)
  ram                                       String?                          @db.VarChar(50)
  storage                                   String?                          @db.VarChar(50)
  personalRemarks                           String?                          @map("personal_remarks")
  customer_documents                        customer_documents[]
  customers_customers_source_lead_idToleads Customer[]                       @relation("customers_source_lead_idToleads")
  email_lead_ingestion_log                  email_lead_ingestion_log[]
  activities                                LeadActivity[]
  addresses                                 LeadAddress[]
  assignments                               LeadAssignment[]
  research                                  LeadCompanyResearch?
  lead_followup_in_app_reminders            lead_followup_in_app_reminders[]
  lead_followup_notifications               lead_followup_notifications[]
  orders                                    LeadOrder[]
  lead_remarks                              lead_remarks[]
  assignedBy                                User?                            @relation("LeadAssignedBy", fields: [assignedById], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  assignedUser                              User?                            @relation("LeadAssigned", fields: [assignedUserId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  users_leads_converted_byTousers           User?                            @relation("leads_converted_byTousers", fields: [convertedBy], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  customers_leads_customer_idTocustomers    Customer?                        @relation("leads_customer_idTocustomers", fields: [customerId], references: [customerId], onDelete: NoAction, onUpdate: NoAction)
  duplicateLead                             Lead?                            @relation("LeadDuplicate", fields: [duplicateOf], references: [leadId], onDelete: NoAction, onUpdate: NoAction)
  duplicates                                Lead[]                           @relation("LeadDuplicate")
  sales_quotations                          sales_quotations[]

  @@index([assignedUserId], map: "idx_leads_assigned")
  @@index([email], map: "idx_leads_email")
  @@index([followUpDate], map: "idx_leads_follow_up")
  @@index([phone], map: "idx_leads_phone")
  @@index([status], map: "idx_leads_status")
  @@map("leads")
}

model LeadActivity {
  activityId Int       @id @default(autoincrement()) @map("activity_id")
  leadId     Int?      @map("lead_id")
  userId     Int?      @map("user_id")
  action     String?   @db.VarChar(50)
  statusFrom String?   @map("status_from") @db.VarChar(50)
  statusTo   String?   @map("status_to") @db.VarChar(50)
  notes      String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
