# Database — local Docker: DB_HOST=127.0.0.1 DB_PORT=5433 DB_SSL=false
# Prefer 127.0.0.1 over localhost on Windows (Docker Postgres is IPv4-only).
# Set DB_SSL=false unless the server expects TLS (managed DBs often need SSL).
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=laptop_refurbishment
DB_USER=your-username
DB_PASSWORD=your-password
DB_SSL=false

# JWT Secret (Generate a random string)
JWT_SECRET=your-very-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS) — comma-separate CRM + vendor portal origins
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Public URL for GRN capture links (use on staging/production VPS)
# GRN_CAPTURE_PUBLIC_URL=https://staging.rentfoxxy.com
# PUBLIC_API_URL=https://staging.rentfoxxy.com/api
VENDOR_PORTAL_URL=http://localhost:3001
CUSTOMER_PORTAL_URL=http://localhost:3002
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Email (PO approval, invoices, sale DC accounts alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@rentfoxxy.com
FROM_EMAIL=noreply@rentfoxxy.com
# Dispatch mail — sale DC accounts notification (separate from main SMTP_*)
DISPATCH_SMTP_HOST=
DISPATCH_SMTP_PORT=587
DISPATCH_SMTP_SECURE=false
DISPATCH_SMTP_USER=
DISPATCH_SMTP_PASS=
DISPATCH_SMTP_FROM=
# DISPATCH_SMTP_REPLY_TO=
# Recipient for sale DC E-Invoice requests (default: accounts@truetechservices.in)
# ACCOUNTS_EMAIL=accounts@truetechservices.in

# Ops alert email — receives billing cron failure notifications (optional; falls back to SMTP_USER)
# WAREHOUSE_LEAD_EMAIL=warehouse@rentfoxxy.com
# OPS_ALERT_EMAIL=accounts@rentfoxxy.com

# Lead email auto-import (website enquiry emails via IMAP)
# LEAD_EMAIL_IMAP_HOST=imap.gmail.com
# LEAD_EMAIL_IMAP_PORT=993
# LEAD_EMAIL_IMAP_SECURE=true
# LEAD_EMAIL_IMAP_USER=leads@rentfoxxy.com
# LEAD_EMAIL_IMAP_PASS=your-app-password
# LEAD_EMAIL_MAILBOXES=INBOX,[Gmail]/Sent Mail
# LEAD_EMAIL_IDLE_MAILBOX=INBOX
# LEAD_EMAIL_SYNC_DEBOUNCE_MS=2000
# LEAD_EMAIL_IDLE_RECONNECT_MS=1000
# LEAD_EMAIL_IDLE_MAX_RECONNECT_MS=60000
# LEAD_EMAIL_LOOKBACK_DAYS=14
# Auto-assign new leads (email sync, CSV import, admin create) to Harshit (user_id 31):
# LEAD_AUTO_ASSIGN_USER_ID=31
# LEAD_AUTO_ASSIGN_EMAIL=harshit@rentfoxxy.com
# ENABLE_BACKGROUND_WORKERS=true

# Company details (PO PDF / e-invoice)
COMPANY_NAME=Rentfoxxy Technologies Pvt Ltd
COMPANY_GSTIN=

# Zoho GSP (E-Invoice + E-Way Bill)
ZOHO_GSP_CLIENT_ID=
ZOHO_GSP_CLIENT_SECRET=
ZOHO_GSP_USERNAME=
ZOHO_GSP_PASSWORD=
ZOHO_GSP_SANDBOX=true

# Zoho Books — GSTIN autofill (temporary: paste Cookie + X-ZCSRF-TOKEN from working browser curl)
# ZOHO_BOOKS_ORGANIZATION_ID=60016279097
# ZOHO_BOOKS_COOKIE=
# ZOHO_BOOKS_CSRF_TOKEN=
# ZOHO_BOOKS_SESSION_URL=https://books.zoho.in/api/v3/search/gstin
# Later (OAuth — optional):
# ZOHO_BOOKS_CLIENT_ID=
# ZOHO_BOOKS_CLIENT_SECRET=
# ZOHO_BOOKS_REFRESH_TOKEN=
# ZOHO_BOOKS_API_BASE=https://www.zohoapis.in/books/v3
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
COMPANY_ADDRESS=
COMPANY_STATE_CODE=06
COMPANY_PINCODE=
COMPANY_HSN_CODE=84713000

# =============================================================================
# Prisma (required): must match DB_* host/port/name/user/password above.
# With SSH tunnel: use 127.0.0.1 and the LOCAL tunnel port (e.g. 5433).
# URL-encode special characters in DB_PASSWORD (# @ : % spaces, etc.).
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5433/postgres
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5433/postgres?sslmode=disable
# =============================================================================
DATABASE_URL=

# ERP MySQL — attribute-management migration (scripts/migrate-erp-asset-configuration.js)
# ERP_MYSQL_HOST=127.0.0.1
# ERP_MYSQL_PORT=3306
# ERP_MYSQL_USER=erp_user
# ERP_MYSQL_PASSWORD=
# ERP_MYSQL_DATABASE=rentfoxxy_erp

# BlueDart AWB tracking (TNT RoutingServlet — server-side only)
# BLUEDART_LOGIN_ID=GGN37318
# BLUEDART_LICENSE_KEY=           # tracking lickey (may differ from waybill)
# BLUEDART_TRACKING_URL=https://api.bluedart.com/servlet/RoutingServlet
# BLUEDART_TRACKING_VERSION=1

# BlueDart GenerateWayBill (API Gateway — used when creating DC via Courier)
# BLUEDART_WAYBILL_LICENSE_KEY=   # optional; falls back to BLUEDART_LICENSE_KEY
# BLUEDART_CUSTOMER_CODE=988621
# BLUEDART_ORIGIN_AREA=GGN
# BLUEDART_SHIPPER_NAME=TRUETECH SERVICES P LTD
# BLUEDART_SHIPPER_ADDRESS=B-12 OMAXE CITY CENTRE, SOHNA ROAD GURGAON
# BLUEDART_SHIPPER_PINCODE=122018
# BLUEDART_SHIPPER_MOBILE=9311770430
# BLUEDART_PRODUCT_CODE=A
# BLUEDART_SUB_PRODUCT_CODE=P
# BLUEDART_WAYBILL_URL=https://apigateway.bluedart.com/in/transportation/waybill/v1/GenerateWayBill
# BLUEDART_CANCEL_WAYBILL_URL=https://apigateway.bluedart.com/in/transportation/waybill/v1/CancelWaybill
# BLUEDART_UPDATE_EWAYBILL_URL=https://apigateway.bluedart.com/in/transportation/waybill/v1/UpdateEwayBill
# BLUEDART_SELLER_GST_NO=           # for UpdateEwayBill; falls back to COMPANY_GSTIN
# Sandbox (if needed):
# BLUEDART_WAYBILL_URL=https://apigateway-sandbox.bluedart.com/in/transportation/waybill/v1/GenerateWayBill
# BLUEDART_CANCEL_WAYBILL_URL=https://apigateway-sandbox.bluedart.com/in/transportation/waybill/v1/CancelWaybill
# BLUEDART_UPDATE_EWAYBILL_URL=https://apigateway-sandbox.bluedart.com/in/transportation/waybill/v1/UpdateEwayBill
# BLUEDART_TOKEN_URL=https://apigateway-sandbox.bluedart.com/in/transportation/token/v1/login
# BLUEDART_TOKEN_URL=https://apigateway.bluedart.com/in/transportation/token/v1/login
# Optional JWT (if gateway requires it):
# BLUEDART_CLIENT_ID=
# BLUEDART_CLIENT_SECRET=
# BLUEDART_JWT_TOKEN=

# Support pickup WhatsApp OTP + damage images (Bug 4 — off by default; safe fallback)
# SUPPORT_PICKUP_WHATSAPP_OTP=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
