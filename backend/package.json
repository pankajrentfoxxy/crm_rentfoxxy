{
  "name": "laptop-refurbishment-backend",
  "version": "1.0.0",
  "description": "Backend API for Laptop Refurbishment Workflow System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js && node scripts/verify-billing-edge-cases.js",
    "test:unit": "node --test test/*.test.js",
    "normalize:asset-config": "node scripts/normalize-asset-configuration.js",
    "check:asset-config": "node scripts/check-asset-configuration.js",
    "migrate:asset-config": "node scripts/migrate-erp-asset-configuration.js",
    "prisma:generate": "prisma generate",
    "prisma:sync": "prisma db pull && node scripts/update-prisma-sync-marker.js",
    "check:prisma-drift": "node scripts/check-prisma-drift.js",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "refurbishment",
    "workflow",
    "laptop"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "imapflow": "^1.2.9",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pino": "^9.14.0",
    "puppeteer": "^23.11.1",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^6.16.1"
  }
}
