# Database (PostgreSQL on VPS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/postgres

# App
JWT_SECRET=CHANGE_ME_RANDOM_32_CHARS
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://187.77.187.213
# Or with domain: FRONTEND_URL=https://erp.yourdomain.com

# Perplexity (Lead Research)
PERPLEXITY_API_KEY=your_perplexity_api_key

# ERP Integration
ERP_BASE_URL=https://erp.rentfoxxy.com/rentfoxxy-api
ERP_API_TOKEN=your_erp_token
ERP_SYNC_INTERVAL_MS=120000

# Lead Email Ingestion (Gmail IMAP)
LEAD_EMAIL_IMAP_HOST=imap.gmail.com
LEAD_EMAIL_IMAP_PORT=993
LEAD_EMAIL_IMAP_SECURE=true
LEAD_EMAIL_IMAP_USER=leads@rentfoxxy.com
LEAD_EMAIL_IMAP_PASS=your_app_password
LEAD_EMAIL_MAILBOXES=Sent,INBOX,[Gmail]/Sent Mail
LEAD_EMAIL_POLL_INTERVAL_MS=10000
LEAD_EMAIL_LOOKBACK_DAYS=30
LEAD_PERSONAL_EMAIL_DOMAINS=gmail.com,yahoo.com,outlook.com,hotmail.com,live.com,msn.com,icloud.com,aol.com,proton.me,protonmail.com,zoho.com,gmx.com,yandex.com,rediffmail.com,mail.com
