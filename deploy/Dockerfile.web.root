# Frontend build with repo root as context (for Hostinger / root docker-compose)
# Builds from frontend/, uses deploy/ nginx configs (auto-detects SSL)

FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/build /usr/share/nginx/html
COPY deploy/nginx.http-only.conf /etc/nginx/conf.d/nginx.http-only.conf
COPY deploy/nginx.ssl.conf /etc/nginx/conf.d/nginx.ssl.conf
COPY deploy/docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh
EXPOSE 80 443
ENTRYPOINT ["/docker-entrypoint.sh"]
