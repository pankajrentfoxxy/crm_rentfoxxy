# ERP MySQL (source) — omit or stop MySQL locally to auto-use ../erp_rentfoxxy_db.sql
ERP_MYSQL_HOST=127.0.0.1
ERP_MYSQL_PORT=3306
ERP_MYSQL_USER=root
ERP_MYSQL_PASSWORD=
ERP_MYSQL_DATABASE=erp_rentfoxxy
# Set true to force SQL dump; otherwise auto-fallback when MySQL is down
# ERP_USE_SQL_DUMP=true
# ERP_SQL_DUMP_PATH=../erp_rentfoxxy_db.sql
# ERP_MYSQL_AUTO_DUMP=false

# Refurb / revemp_backend PostgreSQL (source) — restore laptop_refurbishment_backup.sql first
REFURB_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/laptop_refurbishment
# Or explicit:
# REFURB_PG_HOST=127.0.0.1
# REFURB_PG_PORT=5432
# REFURB_PG_USER=postgres
# REFURB_PG_PASSWORD=
# REFURB_PG_DATABASE=laptop_refurbishment

# CRM PostgreSQL (target)
# Option A: use DATABASE_URL (matches backend/.env)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/postgres?schema=public
# Option B: explicit vars (used if DATABASE_URL is not set)
CRM_PG_HOST=localhost
CRM_PG_PORT=5433
CRM_PG_USER=postgres
CRM_PG_PASSWORD=
CRM_PG_DATABASE=postgres

# Migration control
MIGRATION_BATCH_SIZE=500
MIGRATION_LOG_DIR=./logs
MIGRATION_APPROVED=false

# Optional: copy ERP Laravel files into CRM uploads (see tools/sync-erp-files.js)
# ERP_STORAGE_ROOT=./erp-storage
# CRM_UPLOAD_ROOT=../backend/uploads

# Optional: fetch ERP files from VPS (see tools/fetch-erp-from-vps.js)
# VPS_SSH_KEY=C:/Users/Dell/Downloads/LightsailDefaultKey-ap-south-1.pem
# VPS_HOST=ubuntu@43.205.189.249
# VPS_ERP_PUBLIC=/www/wwwroot/erp.rentfoxxy.com/api/storage/app/public
